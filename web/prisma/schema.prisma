generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Added for credentials provider
  phone         String?   // Phone number
  role          String    @default("member") // 'admin', 'sub-admin', 'member', 'vip'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  answeredPosts Post[]    @relation("PostAnswerer")
}

model Post {
  id            String    @id @default(cuid())
  board         String    // 'notices', 'qna', 'free-board'
  title         String
  content       String
  category      String?   // For notices: '활동','인증','투어','교육' etc
  views         Int       @default(0)
  likes         Int       @default(0)
  answered      Boolean   @default(false) // For QnA only
  answerContent String?   // For QnA answer body (rich text HTML)
  answererId    String?
  answeredAt    DateTime?
  authorId      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author    User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answerer  User?  @relation("PostAnswerer", fields: [answererId], references: [id], onDelete: SetNull)

  @@index([board])
  @@index([authorId])
  @@index([answererId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  unsubscribeToken String    @unique @default(cuid())
  consent          Boolean   @default(true)
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?

  @@index([unsubscribedAt])
}

model Notification {
  id          String   @id @default(cuid())
  type        String   // 'signup' | 'cert' | 'post' | 'comment' | 'subscribe'
  title       String
  message     String
  detail      String?
  actionLabel String?
  actionHref  String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}
